function copySummary() {
    let summary = '🏥 AREA-WISE DONOR SUMMARY\n';
    summary += '═══════════════════════════\n\n';
    summary += `Total Donors: <%= stats.totalDonors %>\n`;
    summary += `Total Areas: <%= stats.totalAreas %>\n`;
    summary += `Active Donors: <%= stats.activeDonors %>\n`;
    summary += `Eligible Donors: <%= stats.eligibleDonors %>\n\n`;
    
    <% if (areas && areas.length > 0) { %>
        summary += '📍 AREA BREAKDOWN:\n';
        <% for(var i = 0; i < areas.length; i++) { 
            var area = areas[i];
            var activeCnt = 0;
            var eligibleCnt = 0;
            if (area.donors) {
                for(var d = 0; d < area.donors.length; d++) {
                    if(area.donors[d].status === 'active') activeCnt++;
                    if(area.donors[d].isEligible) eligibleCnt++;
                }
            }
        %>
            summary += '\n<%= area.name %>:\n';
            summary += `   • Total Donors: <%= area.count %>\n`;
            summary += `   • Active: ${activeCnt}\n`;
            summary += `   • Eligible: ${eligibleCnt}\n`;
        <% } %>
    <% } %>
    
    navigator.clipboard.writeText(summary).then(() => {
        alert('✅ Summary copied to clipboard!');
    }).catch(err => {
        console.error('Copy failed:', err);
        alert('Failed to copy to clipboard');
    });
}
