<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blood Donation for Humanity</title>
    
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    
    <!-- Local CSS -->
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- Dark Theme CSS -->
    <style>
        /* Theme variables */
        :root {
            --bg-color: #f4f6f9;
            --text-color: #212529;
            --sidebar-bg: white;
            --card-bg: white;
            --border-color: #dee2e6;
            --hover-bg: #f8d7da;
        }

        .theme-dark {
            --bg-color: #1a1d21;
            --text-color: #e9ecef;
            --sidebar-bg: #2c3034;
            --card-bg: #2c3034;
            --border-color: #495057;
            --hover-bg: #58151c;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .sidebar {
            background-color: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
        }

        .card, .stat-card {
            background-color: var(--card-bg);
            border-color: var(--border-color);
        }

        .sidebar .nav-link {
            color: var(--text-color);
        }

        .sidebar .nav-link:hover {
            background-color: var(--hover-bg);
        }

        .theme-toggle {
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .theme-toggle:hover {
            transform: scale(1.1);
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="bi bi-droplet"></i> Blood Donation for Humanity
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <!-- theme toggle -->
                    <li class="nav-item me-2">
                        <span class="nav-link theme-toggle" id="themeToggle" title="Toggle dark/light mode">
                            <i class="bi bi-moon-fill"></i>
                        </span>
                    </li>
                    
                    <% if (locals.user && user) { %>
                        <li class="nav-item">
                            <span class="nav-link text-light">
                                <i class="bi bi-person-circle"></i> <%= user.name || 'User' %>
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/donor-login">Donor Login</a>
                        </li>
                        <!-- Admin Login সম্পূর্ণ সরিয়ে দেওয়া হয়েছে - শুধু URL দিয়ে অ্যাক্সেস করা যাবে -->
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <% if (locals.user && user) { %>
                <div class="col-md-3 col-lg-2 px-0">
                    <div class="sidebar">
                        <% if (user.role === 'admin') { %>
                            <h5>Admin Panel</h5>
                            <nav class="nav flex-column">
                                <a class="nav-link" href="/admin/dashboard">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                                <a class="nav-link" href="/admin/donors">
                                    <i class="bi bi-people"></i> Manage Donors
                                </a>
                                <a class="nav-link" href="/admin/donations">
                                    <i class="bi bi-calendar-check"></i> Donations
                                </a>
                                <a class="nav-link" href="/admin/donors/by-area">
                                    <i class="bi bi-geo-alt"></i> Area-wise Listing
                                </a>
                                <a class="nav-link" href="/admin/reports/monthly">
                                    <i class="bi bi-graph-up"></i> Monthly Reports
                                </a>
                                <a class="nav-link" href="/admin/eligibility/upcoming">
                                    <i class="bi bi-alarm"></i> Upcoming Eligible
                                </a>
                            </nav>
                        <% } else { %>
                            <h5>Donor Panel</h5>
                            <nav class="nav flex-column">
                                <a class="nav-link" href="/donor/dashboard">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                                <a class="nav-link" href="/donor/profile">
                                    <i class="bi bi-person"></i> My Profile
                                </a>
                                <a class="nav-link" href="/donor/history">
                                    <i class="bi bi-clock-history"></i> Donation History
                                </a>
                                <a class="nav-link" href="/donor/eligibility">
                                    <i class="bi bi-check-circle"></i> Check Eligibility
                                </a>
                                <a class="nav-link" href="/donor/public-donors">
                                    <i class="bi bi-people"></i> View Donors
                                </a>
                                <!-- ইমার্জেন্সি অপশন -->
                                <a class="nav-link text-danger fw-bold" href="/donor/emergency">
                                    <i class="bi bi-exclamation-triangle-fill"></i> 🚨 Emergency
                                </a>
                            </nav>
                        <% } %>
                    </div>
                </div>
                <div class="col-md-9 col-lg-10">
                    <div class="content">
                        <%- body %>
                    </div>
                </div>
            <% } else { %>
                <div class="col-12">
                    <div class="content">
                        <%- body %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Local JS -->
    <script src="/js/main.js"></script>
    
    <!-- Theme toggle logic -->
    <script>
    (function() {
        // থিম টগল ফাংশন
        const toggle = document.getElementById('themeToggle');
        const root = document.documentElement;
        
        // লোকাল স্টোরেজ থেকে থিম লোড করুন
        const current = localStorage.getItem('theme') || 'light';
        if (current === 'dark') {
            root.classList.add('theme-dark');
        }

        // আইকন আপডেট ফাংশন
        const updateIcon = () => {
            if (toggle) {
                if (root.classList.contains('theme-dark')) {
                    toggle.innerHTML = '<i class="bi bi-sun-fill"></i>';
                } else {
                    toggle.innerHTML = '<i class="bi bi-moon-fill"></i>';
                }
            }
        };

        // টগল ক্লিক ইভেন্ট
        if (toggle) {
            toggle.addEventListener('click', function() {
                root.classList.toggle('theme-dark');
                const theme = root.classList.contains('theme-dark') ? 'dark' : 'light';
                localStorage.setItem('theme', theme);
                updateIcon();
            });
            updateIcon();
        }

        // সক্রিয় নেভ লিংক হাইলাইট করুন
        const currentPath = window.location.pathname;
        document.querySelectorAll('.nav-link').forEach(link => {
            if (link.getAttribute('href') === currentPath) {
                link.classList.add('active');
            }
        });
    })();
    </script>
</body>
</html>