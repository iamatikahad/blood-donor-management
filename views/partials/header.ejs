<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blood Donor Management System</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    
    <!-- Local CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="bi bi-droplet"></i> Blood Donor Management
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <!-- Theme Toggle Button -->
                    <li class="nav-item">
                        <a class="nav-link theme-toggle" href="#" onclick="toggleTheme()">
                            <i class="bi bi-sun-fill" id="theme-icon"></i>
                        </a>
                    </li>
                    
                    <% if (locals.user && user) { %>
                        <li class="nav-item">
                            <span class="nav-link text-light">
                                <i class="bi bi-person-circle"></i> <%= user.name || 'User' %>
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/donor-login">Donor Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/admin-login">Admin Login</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <% if (locals.user && user) { %>
                <div class="col-md-3 col-lg-2 px-0">
                    <div class="sidebar">
                        <% if (user.role === 'admin') { %>
                            <h5>Admin Panel</h5>
                            <nav class="nav flex-column">
                                <a class="nav-link" href="/admin/dashboard">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                                <a class="nav-link" href="/admin/donors">
                                    <i class="bi bi-people"></i> Manage Donors
                                </a>
                                <a class="nav-link" href="/admin/donations">
                                    <i class="bi bi-calendar-check"></i> Donations
                                </a>
                                <a class="nav-link" href="/admin/donors/by-area">
                                    <i class="bi bi-geo-alt"></i> Area-wise Listing
                                </a>
                                <a class="nav-link" href="/admin/reports/monthly">
                                    <i class="bi bi-graph-up"></i> Monthly Reports
                                </a>
                                <a class="nav-link" href="/admin/eligibility/upcoming">
                                    <i class="bi bi-alarm"></i> Upcoming Eligible
                                </a>
                            </nav>
                        <% } else { %>
                            <h5>Donor Panel</h5>
                            <nav class="nav flex-column">
                                <a class="nav-link" href="/donor/dashboard">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                                <a class="nav-link" href="/donor/profile">
                                    <i class="bi bi-person"></i> My Profile
                                </a>
                                <a class="nav-link" href="/donor/history">
                                    <i class="bi bi-clock-history"></i> Donation History
                                </a>
                                <a class="nav-link" href="/donor/eligibility">
                                    <i class="bi bi-check-circle"></i> Check Eligibility
                                </a>
                                <a class="nav-link" href="/donor/public-donors">
                                    <i class="bi bi-people"></i> View Donors
                                </a>
                            </nav>
                        <% } %>
                    </div>
                </div>
                <div class="col-md-9 col-lg-10">
                    <div class="content">