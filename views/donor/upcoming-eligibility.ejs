<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar-check"></i> Upcoming Eligibility</h2>
    <a href="/donor/dashboard" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> 90-Day Rule</h5>
            </div>
            <div class="card-body">
                <p>According to medical guidelines, you must wait at least <strong>90 days</strong> between blood donations. This ensures:</p>
                <ul>
                    <li>Your body has enough time to replenish red blood cells</li>
                    <li>Your iron levels return to normal</li>
                    <li>Your overall health is maintained</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-graph-up"></i> Your Eligibility Timeline</h5>
            </div>
            <div class="card-body">
                <% 
                const today = new Date();
                const lastDonation = donor.lastDonationDate ? new Date(donor.lastDonationDate) : null;
                const eligibleDate = lastDonation ? new Date(lastDonation.setDate(lastDonation.getDate() + 90)) : null;
                %>
                
                <% if(lastDonation) { %>
                    <div class="timeline">
                        <div class="timeline-item">
                            <strong>Last Donation:</strong> 
                            <%= new Date(donor.lastDonationDate).toLocaleDateString() %>
                        </div>
                        <div class="timeline-item mt-3">
                            <strong>Eligible Date:</strong> 
                            <%= eligibleDate.toLocaleDateString() %>
                        </div>
                        <div class="timeline-item mt-3">
                            <strong>Days Remaining:</strong> 
                            <span class="badge bg-warning">
                                <%= Math.ceil((eligibleDate - today) / (1000 * 60 * 60 * 24)) %> days
                            </span>
                        </div>
                    </div>
                <% } else { %>
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle"></i>
                        You have no previous donations. You are eligible to donate now!
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>